---
import ProjectPage from '../../../views/ProjectPage.astro';
import { getProjects, type Project } from '../../../lib/projects';
import { defaultLang, locales, type Lang } from '../../../i18n/config';

export async function getStaticPaths() {
  const langs = locales.filter((lang) => lang !== defaultLang);
  const paths = await Promise.all(
    langs.map(async (lang) =>
      (await getProjects(lang)).map((project) => ({
        params: { lang, slug: project.slug },
        props: { project },
      })),
    ),
  );
  return paths.flat();
}

const lang = Astro.params.lang as Lang;
const { project } = Astro.props as { project: Project };
---

<ProjectPage project={project} lang={lang} />
