---
// Portada en los idiomas que no son el de por defecto: /gl/, /en/, /pt/
import HomePage from '../../views/HomePage.astro';
import { defaultLang, locales, type Lang } from '../../i18n/config';

export function getStaticPaths() {
  return locales.filter((lang) => lang !== defaultLang).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<HomePage lang={lang} />
