---
// Página de detalle de un proyecto (contenido en src/content/projects/<idioma>/<slug>.md)
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Tags from '../components/Tags.astro';
import type { Project } from '../lib/projects';
import { localizePath, type Lang } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
  project: Project;
  lang: Lang;
}

const { project, lang } = Astro.props;
const t = useTranslations(lang);
const { title, summary, year, role, sector, stack, repo, demo, confidential, screenshots } = project.data;
const { Content } = await render(project);

const facts = [
  { label: t('projects.year'), value: String(year) },
  { label: t('projects.role'), value: role },
  { label: t('projects.sector'), value: sector },
].filter((fact) => fact.value);
---

<BaseLayout lang={lang} title={title} description={summary}>
  <article class="container project">
    <a class="back" href={`${localizePath(lang)}#projects`}>← {t('projects.back')}</a>

    <header>
      <h1>{title}</h1>
      <p class="summary">{summary}</p>
      <dl class="facts">
        {facts.map((fact) => (
          <div>
            <dt>{fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))}
      </dl>
      <Tags items={stack} label={t('projects.stack')} />
      {(repo || demo) && (
        <p class="links">
          {repo && <a class="button" href={repo} rel="noopener" target="_blank">{t('projects.repo')}</a>}
          {demo && <a class="button primary" href={demo} rel="noopener" target="_blank">{t('projects.demo')}</a>}
        </p>
      )}
    </header>

    {confidential && <p class="notice">{t('projects.confidentialNote')}</p>}

    <div class="prose">
      <Content />
    </div>

    {screenshots.length > 0 && (
      <section class="screenshots" aria-label={t('projects.screenshots')}>
        <h2>{t('projects.screenshots')}</h2>
        <div class="gallery">
          {screenshots.map((shot) => (
            <figure>
              <Image src={shot.src} alt={shot.alt} width={360} />
              <figcaption>{shot.alt}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .project {
    padding-block: clamp(2rem, 6vw, 4rem) clamp(3rem, 8vw, 5rem);
  }
  .back {
    font-size: 0.9rem;
    text-decoration: none;
  }
  header {
    margin: 1.5rem 0 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }
  h1 {
    margin: 0;
    font-size: clamp(1.875rem, 6vw, 2.75rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .summary {
    max-width: 40rem;
    margin: 1rem 0 1.5rem;
    font-size: 1.125rem;
    color: var(--muted);
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2.5rem;
    margin: 0 0 1.25rem;
  }
  dt {
    font-size: 0.8rem;
    color: var(--muted);
  }
  dd {
    margin: 0;
    font-weight: 600;
  }
  .notice {
    max-width: 42rem;
    margin: 0 0 2rem;
    padding: 0.875rem 1rem;
    border-left: 3px solid var(--accent);
    border-radius: 0.375rem;
    background: var(--surface);
    font-size: 0.95rem;
    color: var(--muted);
  }
  .screenshots {
    margin-top: 3rem;
  }
  .screenshots h2 {
    margin: 0 0 1rem;
    font-size: 1.375rem;
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr));
    align-items: start;
    gap: 1rem;
  }
  figure {
    margin: 0;
  }
  figure img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  figcaption {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.5rem 0 0;
  }
</style>
